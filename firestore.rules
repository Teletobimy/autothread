rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: Check if user is a member of the organization
    function isMember(orgId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }
    
    // Helper function: Check if user is owner or admin of the organization
    function isAdmin(orgId) {
      let member = get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
      return isAuthenticated() && 
        member != null && 
        (member.data.role == 'owner' || member.data.role == 'admin');
    }
    
    // Helper function: Check if user is owner of the organization
    function isOwner(orgId) {
      let member = get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
      return isAuthenticated() && 
        member != null && 
        member.data.role == 'owner';
    }
    
    // ============================================
    // Users collection (글로벌 - Auth 연동용)
    // ============================================
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // ============================================
    // Orgs collection (단일 최상위 테넌트)
    // ============================================
    match /orgs/{orgId} {
      // Any authenticated user can create an organization
      allow create: if isAuthenticated();
      
      // Only members can read organization data
      allow read: if isMember(orgId);
      
      // Only admins can update organization
      allow update: if isAdmin(orgId);
      
      // Only owner can delete organization
      allow delete: if isOwner(orgId);
      
      // ---------- Members ----------
      match /members/{memberId} {
        allow read: if isMember(orgId);
        allow create: if isAdmin(orgId) || 
          (isAuthenticated() && request.auth.uid == memberId);
        allow delete: if isAdmin(orgId);
        allow update: if isOwner(orgId);
      }
      
      // ---------- Invitations (조직 내부) ----------
      match /invitations/{inviteId} {
        allow read: if isMember(orgId) || 
          (isAuthenticated() && resource.data.email == request.auth.token.email);
        allow create: if isAdmin(orgId);
        allow update: if isAdmin(orgId) || 
          (isAuthenticated() && resource.data.email == request.auth.token.email);
        allow delete: if isAdmin(orgId);
      }
      
      // ---------- Tools ----------
      match /tools/{toolId} {
        allow read: if isMember(orgId);
        allow write: if isAdmin(orgId);
        
        // Config subcollection
        match /config/{configId} {
          allow read, write: if isAdmin(orgId);
        }
        
        // Queue subcollection for posts
        match /queue/{postId} {
          allow read: if isMember(orgId);
          allow create: if isMember(orgId);
          allow update, delete: if isAdmin(orgId) || 
            (isMember(orgId) && resource.data.createdBy == request.auth.uid);
        }
      }
      
      // ---------- Settings ----------
      match /settings/{settingId} {
        allow read: if isMember(orgId);
        allow write: if isAdmin(orgId);
      }
    }
    
    // ============================================
    // Legacy collections (마이그레이션용)
    // ============================================
    match /organizations/{orgId} {
      allow read, write: if isAuthenticated();
      match /{document=**} {
        allow read, write: if isAuthenticated();
      }
    }
    
    match /invitations/{inviteId} {
      allow read, write: if isAuthenticated();
    }
    
    match /queue/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
